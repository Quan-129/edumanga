rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Phân vùng bảo mật độc lập tuyệt đối cho từng tài khoản
    // Người dùng chỉ có quyền đọc & ghi dữ liệu bên trong khoang users/{userId}/... của chính mình
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. Dữ liệu công khai hệ thống (nếu có - chỉ cho phép đọc, không cho phép client tự sửa)
    match /system_metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Hệ thống bình luận cộng đồng (Public Read, Authenticated Write)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
